HOST=127.0.0.1
PORT=3420
DATA_DIR=./data
# Set a strong password; otherwise the initial password is saved to data/admin-password.
ADMIN_PASSWORD=
# Leave blank to generate and persist data/master-key. Back up this file with the database.
ENCRYPTION_KEY=
# Enable behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:3420
# Chromium is discovered locally, or set its executable.
CHROME_EXECUTABLE=
BROWSER_EXECUTABLE_PATH=
# Optional private browser sidecar. Leave empty for the local browser service.
BROWSER_SERVICE_URL=
BROWSER_SERVICE_TOKEN=
